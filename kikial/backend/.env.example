ORT=4000

# Bắt buộc cho production: khoá ký token đăng nhập.
# Sinh khoá: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Ollama chạy local — chỉ cần địa chỉ gốc, KHÔNG kèm đường dẫn /v1/chat/completions
# (đó là kiểu OpenAI cũ, không dùng ở đây; dùng nhầm sẽ khiến model luôn báo offline).
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=llama3.2:3b
AI_EMBEDDING_MODEL=nomic-embed-text
AI_TEMPERATURE=0.4
AI_TIMEOUT_MS=30000

# Đặt true để tắt hẳn việc gọi model (chỉ dùng câu trả lời có sẵn/kho kiến thức) — hữu ích khi test.
AI_DISABLE_MODEL=false

# Đặt true để log lại từng quyết định của orchestrator (intent, retrieval, model có được gọi không...).
AI_OBSERVABILITY=false
