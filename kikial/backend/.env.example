PORT=4000

# Bắt buộc cho production: khoá ký token đăng nhập đủ dài và ngẫu nhiên.
# Sinh khoá: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Tài khoản admin khởi tạo. Hãy đổi mật khẩu mặc định trước khi public server.
ADMIN_EMAIL=admin@kikial.local
ADMIN_NAME=Admin Kikial
ADMIN_PASSWORD=admin123

# SECURITY / HTTP
# Production: liệt kê origin frontend được phép, phân cách bằng dấu phẩy.
# Ví dụ: https://ai.example.com,https://admin.example.com
CORS_ORIGINS=
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=12
RATE_LIMIT_CHAT_MAX=40
RATE_LIMIT_ADMIN_MAX=120
RATE_LIMIT_API_MAX=180
RATE_LIMIT_DISABLED=false
MAX_PAYLOAD_BYTES=1000000

# STORAGE
# Mặc định document RAG dùng SQLite (Node 22+), tự migrate documents.json nếu DB đang rỗng.
# json = luôn dùng JSON; sqlite-strict = không fallback nếu SQLite lỗi.
DOCUMENT_STORAGE_DRIVER=sqlite
KIKIAL_DATABASE_PATH=./data/kikial.sqlite
KIKIAL_DOCUMENTS_PATH=./data/documents.json
DOCUMENT_CHUNK_CHARS=1400
DOCUMENT_CHUNK_OVERLAP=180
MAX_DOCUMENT_CHUNKS=400
MAX_UPLOAD_SIZE=2000000

# MODEL PROVIDER
# 1) Ollama local:
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434
AI_MODEL=llama3.2:3b
AI_EMBEDDING_MODEL=nomic-embed-text
AI_API_KEY=

# Tự chọn model chat mạnh nhất đang cài trong Ollama (bỏ qua embedding model).
# Đặt false nếu muốn khóa chính xác AI_MODEL ở trên.
AI_MODEL_AUTO=true

# Tuỳ chọn multi-model routing. Nếu model chuyên dụng chưa được cài trong Ollama,
# Kikial tự rơi về AI_MODEL / model mạnh nhất đang có.
AI_CODING_MODEL=
AI_REASONING_MODEL=
AI_FAST_MODEL=

# Danh sách model fallback, cách nhau bằng dấu phẩy. Nếu model chính lỗi/offline,
# Kikial thử lần lượt các model đã cài trong Ollama.
AI_FALLBACK_MODELS=llama3.2:3b

# Gate dùng khi tự promote candidate sau benchmark.
PROMOTION_MIN_PASS_RATE=0.85
PROMOTION_MIN_GROUP_RATE=0.70

# 2) Hoặc server tương thích OpenAI (LM Studio, vLLM, llama.cpp server, gateway...):
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=http://127.0.0.1:1234/v1
# AI_MODEL=<model-id>
# AI_EMBEDDING_MODEL=<embedding-model-id>
# AI_API_KEY=<optional-key>

AI_TEMPERATURE=0.4
AI_TIMEOUT_MS=120000

# Ngữ cảnh lớn hơn giúp hội thoại dài tốt hơn nhưng tốn RAM/context window của model.
MAX_CONTEXT_CHARS=12000

# Live web retrieval (khuyến nghị chạy SearXNG local để giữ riêng tư).
# Ví dụ: SEARXNG_URL=http://127.0.0.1:8080
SEARXNG_URL=
WEB_SEARCH_ALWAYS=false
WEB_SEARCH_LANGUAGE=vi-VN
WEB_SEARCH_TIMEOUT_MS=8000
WEB_SEARCH_MAX_PER_DOMAIN=2
# Tuỳ chọn: chỉ cho phép hoặc chặn domain, phân cách bằng dấu phẩy.
WEB_SEARCH_ALLOW_DOMAINS=
WEB_SEARCH_BLOCK_DOMAINS=
# Tuỳ chọn SearXNG: general, news, science... / day, week, month, year.
WEB_SEARCH_CATEGORIES=general
WEB_SEARCH_TIME_RANGE=

# RAG / evidence
# Ngưỡng cao hơn giúp tránh evidence gần chủ đề nhưng không trả lời đúng câu hỏi.
MIN_RELEVANCE_SCORE=0.35
MAX_EVIDENCE_CHUNKS=5
MAX_EVIDENCE_CHARS=2800

# Số synthetic candidates tạo khi chạy training:prepare. Chúng KHÔNG tự vào dataset
# cho đến khi được duyệt bằng training:review.
SYNTHETIC_TRAINING_COUNT=0

# Dev frontend tùy chọn. Để trống thì backend phục vụ kikial/web/dist khi đã build.
WEB_DEV_URL=

# Tắt model thật để chạy deterministic/offline tests.
AI_DISABLE_MODEL=false

# Log quyết định của orchestrator: intent, retrieval, model calls, verification...
AI_OBSERVABILITY=false

# Chạy thêm một lượt tự kiểm tra câu trả lời cho câu khó/research (tốn thêm thời gian model).
AI_SELF_CRITIQUE=true
