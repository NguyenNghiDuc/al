PORT=4000
# Bắt buộc cho production: khoá ký token đăng nhập.
# Sinh khoá: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Ollama local: http://127.0.0.1:11434/v1/chat/completions
AI_API_KEY=
AI_API_URL=http://127.0.0.1:11434/v1/chat/completions

# qwen2.5:0.5b bịa rất nhiều; dùng model >= 7B nếu máy chịu được.
AI_MODEL=qwen2.5:7b
AI_TEMPERATURE=0.4
AI_TIMEOUT_MS=30000
